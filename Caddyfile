{
	admin off
	skip_install_trust
	# HTTPS only: no plain-HTTP listener (the container runs unprivileged).
	auto_https disable_redirects
	servers {
		protocols h1 h2 # only TCP 8443 is published
	}
}

{$SITE_HOST:localhost}:8443 {
	tls internal

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		# 'unsafe-inline' styles only: Radix primitives inject <style> elements at runtime.
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}

	encode zstd gzip

	handle /api/* {
		reverse_proxy api:8000
	}

	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
