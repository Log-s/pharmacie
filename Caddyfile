{
	admin off
	# Plain HTTP only: TLS is terminated by the host's nginx in front of this container.
	auto_https off
	servers {
		protocols h1
		# Keep the client address and scheme set by nginx (the api reads X-Forwarded-For for rate limiting).
		trusted_proxies static private_ranges
	}
}

http://:8080 {
	header {
		# 'unsafe-inline' styles only: Radix primitives inject <style> elements at runtime.
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		Cross-Origin-Opener-Policy "same-origin"
		Cross-Origin-Resource-Policy "same-origin"
		-Server
	}

	encode zstd gzip

	handle /api/* {
		# Personal data and session-bound answers: never cached by the browser or a proxy.
		header Cache-Control "no-store"
		# JSON bodies only (largest: a note, body_html <= 200 000 characters); bigger bodies get 413 at the proxy.
		request_body {
			max_size 1MB
		}
		reverse_proxy api:8000
	}

	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
